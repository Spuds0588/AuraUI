{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraUI",
  "version": "0.1.0",
  "identifier": "dev.auraui.canvas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuraUI",
        "label": "main",
        "width": 1180,
        "height": 820,
        "resizable": false,
        "maximized": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": false,
        "focus": true,
        "visible": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Human-in-the-Loop canvas for AI agents",
    "longDescription": "AuraUI lets an AI agent summon interactive UI - action cards, wizard forms, data grids, sortable lists and drill-down charts - and streams the human's answer straight back over a local WebSocket. Questions fade up one at a time over the desktop and the overlay gets out of the way when nothing is being asked.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
